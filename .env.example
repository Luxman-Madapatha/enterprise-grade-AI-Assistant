# =============================================================================
# Enterprise AI Assistant - environment configuration
# Copy this file to `.env` and fill in the values you want to enable.
# The application degrades gracefully: with NO keys set it runs end-to-end
# using deterministic mock components (perfect for local demo / evaluation).
# =============================================================================

# ---- General ----
APP_NAME="Enterprise AI Assistant"
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- LLM (set OPENAI_API_KEY to use a real model; otherwise mock LLM is used) ----
LLM_PROVIDER=openai            # openai | mock  (auto-falls back to mock if no key)
OPENAI_API_KEY=
OPENAI_BASE_URL=               # optional, e.g. http://localhost:11434/v1 for Ollama
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- Pinecone (set to true + key to use managed vector DB; local fallback otherwise) ----
USE_PINECONE=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- LangSmith (mandatory requirement; set key to trace, otherwise local traces) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_TRACING_V2=true

# ---- Auth (HMAC-signed tokens) ----
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_EXPIRY_MINUTES=60

# ---- Rate limiting (token bucket) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SECOND=1.0

# ---- Retrieval ----
TOP_K=8
CHUNK_SIZE=800
CHUNK_OVERLAP=100
